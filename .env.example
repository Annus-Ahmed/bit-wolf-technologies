# Local default is localhost. On Vercel, leave blank for automatic URL detection,
# or set the final HTTPS site origin in the Production environment only.
NEXT_PUBLIC_SITE_URL=
# Recipient inbox for project enquiries (Config)
CONTACT_EMAIL=
# Server-only Resend sending key (Secret)
RESEND_API_KEY=
# Example format: BIT-WOLF Technologies <enquiries@YOUR-VERIFIED-DOMAIN>
# Use a sender on a domain you have verified with Resend (Config).
EMAIL_FROM=
# Required for production enquiry delivery; optional for local development.
# Copy both from Upstash Redis > Connect > REST. Use the read/write token.
UPSTASH_REDIS_REST_URL=
# Server-only Redis REST token (Secret)
UPSTASH_REDIS_REST_TOKEN=
